# Copy to .env.local (git-ignored) and adjust. On Vercel, add the same keys under
# Project Settings → Environment Variables.

# Required: base URL of the products API (server-only — not exposed to the browser).
# Endpoint paths live in each service folder, e.g. src/api/products/products.constants.ts.
API_BASE_URL=https://api-one-alpha-60.vercel.app

# Optional: public URL for canonical and Open Graph URLs.
# On Vercel the production domain is used automatically; set this only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
